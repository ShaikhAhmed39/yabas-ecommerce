# ============ FRONTEND (Vercel / Netlify -> Environment Variables) ============
# These two are PUBLIC by design (the anon key is protected by row-level security).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Must match RETURN_WINDOW_DAYS below (display only; the server enforces it)
VITE_RETURN_WINDOW_DAYS=7

# ============ BACKEND SECRETS ============
# These do NOT go in this file or in Git. Set them with:
#   supabase secrets set --env-file ./supabase/functions/.env.production
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.)
# The block below is the complete list, for reference.

# ---- General ----
APP_ENV=production                    # "production" refuses test Razorpay keys and mock shipping
ALLOWED_ORIGINS=https://yourshop.in,https://www.yourshop.in
CRON_SECRET=                          # any long random string (also used by the gold-price cron)

# ---- Razorpay (Dashboard -> Account & Settings -> API Keys / Webhooks) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=              # the secret YOU type when creating the webhook (not the API secret)
RAZORPAY_REFUND_SPEED=normal          # normal | optimum

# ---- Shipping: SHIPROCKET ----
SHIPPING_MODE=mock                    # mock = fake courier for testing | live = real Shiprocket
SHIPROCKET_API_EMAIL=                 # an API USER created in Shiprocket (Settings -> API -> Create API User)
SHIPROCKET_API_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=           # exact "Pickup Location" nickname saved in the Shiprocket panel, e.g. Primary
SHIPROCKET_PICKUP_PINCODE=            # pincode of that pickup address
SHIPROCKET_WEBHOOK_TOKEN=             # any long random string; paste the same value into the Shiprocket webhook page
SHIPROCKET_COURIER_ID=                # optional: force one courier; empty = Shiprocket picks the recommended one
TRACKING_URL_TEMPLATE=https://shiprocket.co/tracking/{awb}

# ---- Your warehouse (where RETURNS are delivered) ----
WAREHOUSE_NAME=
WAREHOUSE_ADDRESS=
WAREHOUSE_ADDRESS_2=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_PINCODE=
WAREHOUSE_PHONE=
WAREHOUSE_EMAIL=

# ---- Parcel defaults (jewellery box) ----
SHIPPING_DEFAULT_LENGTH_CM=12
SHIPPING_DEFAULT_BREADTH_CM=10
SHIPPING_DEFAULT_HEIGHT_CM=5
SHIPPING_MIN_WEIGHT_KG=0.5
SHIPPING_HSN_CODE=7117                # imitation jewellery

# ---- Returns ----
RETURN_WINDOW_DAYS=7
RETURN_AUTO_PICKUP=true               # approve = pickup booked automatically

# ---- E-mails (optional; without these nothing is sent and nothing breaks) ----
RESEND_API_KEY=
MAIL_FROM="Yaba's Jewellery <orders@yourshop.in>"   # a domain verified in Resend
MAIL_SIGNATURE=Yaba's Imitation & Jewellery

# ---- Gold rate (existing function) ----
GOLDAPI_KEY=
